PROJECT_NAME="AEROKRYPT Planetary Science API"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000

# PostgreSQL
DATABASE_URL="postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/DATABASE"
SQLITE_FALLBACK_URL="sqlite:///./aerokrypt.db"

# Authentication
JWT_SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME="access_token"

# GIS and external APIs
RASTER_CACHE_DIR="./raster_cache"
NASA_PDS_SEARCH_URL="https://pds.nasa.gov/api/search/1.0"
USGS_3DEP_API_URL="https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer"
EARTH_SEARCH_STAC_URL="https://earth-search.aws.element84.com/v1"
